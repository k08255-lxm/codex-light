<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>CodexLight</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.5</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>码舱 CodeCang</Product><Title>码舱 CodeCang</Title>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'"><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" /></ItemGroup>
  <!-- Experimental packaging opt-in: -p:EnableVelopackPrototype=true.
       The default MSI build has no Velopack dependency or startup hook.
       This does not migrate MSI installs or enable the production updater. -->
  <PropertyGroup Condition="'$(EnableVelopackPrototype)' == 'true'">
    <DefineConstants>$(DefineConstants);VELOPACK_PROTOTYPE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableVelopackPrototype)' == 'true'">
    <PackageReference Include="Velopack" Version="1.3.39-g8d2844f" />
  </ItemGroup>
  <!-- WebView2 adds both UI frameworks; this host uses WinForms only. -->
  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
  <ItemGroup><Compile Remove="bootstrap/**/*.cs;setup/**/*.cs;velopack/**/*.cs" /></ItemGroup>
</Project>
