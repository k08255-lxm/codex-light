 <ItemGroup Condition="Exists('$(PayloadManifest)')"><EmbeddedResource Include="$(PayloadManifest)" LogicalName="CodexLight.PayloadManifest" /></ItemGroup>
  <ItemGroup Condition="Exists('../../docs/legacy-repair-v7-evidence.json')"><EmbeddedResource Include="../../docs/legacy-repair-v7-evidence.json" LogicalName="CodexLight.LegacyV7Evidence" /></ItemGroup>
