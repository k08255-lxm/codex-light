<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting><PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit><LangVersion>latest</LangVersion><Nullable>enable</Nullable><AssemblyName>CodexLightSetup</AssemblyName><ApplicationIcon>../app.ico</ApplicationIcon><ApplicationManifest>setup.manifest</ApplicationManifest><GenerateAssemblyInfo>true</GenerateAssemblyInfo><Version>0.4.0</Version><AssemblyVersion>0.4.0.0</AssemblyVersion><FileVersion>0.4.0.0</FileVersion><Product>Codex Light</Product><AssemblyTitle>Codex Light Setup</AssemblyTitle><Description>Codex Light installer with verified prerequisites and embedded Windows Installer package.</Description><Company>Codex Light contributors</Company></PropertyGroup>
 <ItemGroup><PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All"/><Reference Include="System.Net.Http"/><Reference Include="System.Runtime.Serialization"/><EmbeddedResource Include="../installer/dependencies.lock.json" LogicalName="CodexLight.dependencies.lock.json"/><EmbeddedResource Include="../app.ico" LogicalName="CodexLight.Icon"/><EmbeddedResource Include="$(MsiPath)" LogicalName="CodexLight.Application.msi" Condition="Exists('$(MsiPath)')"/><Compile Include="../bootstrap/RuntimeDetection.cs" Link="RuntimeDetection.cs"/><Compile Include="../bootstrap/DependencyInstaller.cs" Link="DependencyInstaller.cs"/><Compile Include="../shared/ProcessIntegrity.cs" Link="ProcessIntegrity.cs"/><Compile Include="../shared/NodeRuntimeDetection.cs" Link="NodeRuntimeDetection.cs"/><Compile Remove="tests/**/*.cs"/></ItemGroup>
 <Target Name="RequireMsi" BeforeTargets="PrepareForBuild"><Error Condition="!Exists('$(MsiPath)')" Text="Pass -p:MsiPath=absolute path to the validated application MSI."/></Target>
</Project>
