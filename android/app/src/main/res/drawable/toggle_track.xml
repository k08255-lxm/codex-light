<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <padding android:left="3dp" android:right="3dp" />
            <solid android:color="@color/accent_primary" />
        </shape>
    </item>
    <item>
        <shape>
            <size android:width="44dp" android:height="24dp" />
            <corners android:radius="12dp" />
            <padding android:left="3dp" android:right="3dp" />
            <solid android:color="@color/bg_selected" />
            <stroke android:width="1dp" android:color="@color/text_muted" />
        </shape>
    </item>
</selector>
